* text=auto eol=lf

*.sh text eol=lf
*.php text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.typoscript text eol=lf
*.ts text eol=lf

# Keep git archive distributions (GitHub source zips, composer archive)
# clean. NOTE: tailor's TER upload ignores export-ignore — it filters by
# its own fixed list (conf/ExcludeFromPackaging.php, overridable via the
# TYPO3_EXCLUDE_FROM_PACKAGING env var in publish.yml).
/.Build/ export-ignore
/.ddev/ export-ignore
/.github/ export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/Build/ export-ignore
/Tests/ export-ignore
/docs/ export-ignore
/AGENTS.md export-ignore
/CONTRIBUTING.md export-ignore
